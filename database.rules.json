{
  "rules": {
    "hunt": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'PASTE_HOST_UID'",
      "teams": {
        "$teamId": {
          ".validate": "newData.hasChildren(['name', 'color']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
        }
      },
      "awards": {
        "$awardId": {
          ".validate": "newData.hasChildren(['teamId', 'points', 'label', 'ts']) && newData.child('points').isNumber()"
        }
      }
    }
  }
}
